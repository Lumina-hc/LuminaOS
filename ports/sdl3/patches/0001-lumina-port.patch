diff --git a/src/timer/lumina/SDL_systimer.c b/src/timer/lumina/SDL_systimer.c
new file mode 100644
index 0000000..a3ee0b8
--- /dev/null
+++ b/src/timer/lumina/SDL_systimer.c
@@ -0,0 +1,42 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2026 Sam Lantinga <slouken@libsdl.org>
+
+  LuminaOS SDL3 timer driver.
+
+  The kernel exposes a monotonic millisecond tick counter through the
+  GET_TICKS syscall (TIMER_HZ = 1000). SDL's performance counter/frequency
+  pair is therefore expressed in 1 kHz units, and SDL_SYS_DelayNS() maps
+  onto the SLEEP syscall (also millisecond resolution).
+*/
+#include "SDL_internal.h"
+
+#ifdef SDL_TIMER_LUMINA
+
+#include "../SDL_timer_c.h"
+#include "../../video/lumina/lumina_syscall.h"
+
+Uint64 SDL_GetPerformanceCounter(void)
+{
+    return (Uint64)lumina_get_ticks();
+}
+
+Uint64 SDL_GetPerformanceFrequency(void)
+{
+    return 1000; /* TIMER_HZ: 1000 ticks per second */
+}
+
+void SDL_SYS_DelayNS(Uint64 ns)
+{
+    /* The SLEEP syscall has millisecond resolution. Round up so we never
+       sleep for less time than requested. */
+    Uint64 ms = (ns + 999999ull) / 1000000ull;
+    if (ms == 0 && ns != 0) {
+        ms = 1;
+    }
+    if (ms > 0) {
+        lumina_sys_sleep((int)(ms > 0x7fffffff ? 0x7fffffff : (long)ms));
+    }
+}
+
+#endif /* SDL_TIMER_LUMINA */
