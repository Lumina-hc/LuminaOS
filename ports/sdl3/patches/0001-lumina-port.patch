diff --git a/src/filesystem/lumina/SDL_sysfilesystem.c b/src/filesystem/lumina/SDL_sysfilesystem.c
new file mode 100644
index 0000000..114d3ec
--- /dev/null
+++ b/src/filesystem/lumina/SDL_sysfilesystem.c
@@ -0,0 +1,338 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2026 Sam Lantinga <slouken@libsdl.org>
+
+  LuminaOS SDL3 filesystem driver.
+
+  The kernel exposes a flat FAT16-ish filesystem through three path-based
+  syscalls: FILE_READ(path, buf, max), FILE_WRITE(path, buf, n) and
+  FILE_LIST(buf, max) which returns dir_entry_t records. There is no
+  create/rename/remove/seek API, so only enumeration, path info, base/pref
+  paths and a simple read/write-backed storage backend are provided; the
+  mutating operations report SDL_Unsupported().
+*/
+#include "SDL_internal.h"
+
+#if defined(SDL_FILESYSTEM_LUMINA) || defined(SDL_FSOPS_LUMINA)
+
+#include "../SDL_sysfilesystem.h"
+#include "../../video/lumina/lumina_syscall.h"
+
+#define LUMINA_FS_ATTR_DIRECTORY 0x10
+#define LUMINA_FS_MAX_ENTRIES    64
+
+/* --- base / pref / user paths ------------------------------------------- */
+
+char *SDL_SYS_GetBasePath(void)
+{
+    /* LuminaOS apps see a flat root filesystem; there is no notion of an
+       executable directory. Return a stable "/" root. */
+    return SDL_strdup("/");
+}
+
+char *SDL_SYS_GetExeName(void)
+{
+    return SDL_strdup("app.elf");
+}
+
+char *SDL_SYS_GetPrefPath(const char *org, const char *app)
+{
+    (void)org; (void)app;
+    /* Preferences are stored at the flat root; no per-app subdirectories. */
+    return SDL_strdup("/");
+}
+
+char *SDL_SYS_GetUserFolder(SDL_Folder folder)
+{
+    (void)folder;
+    return SDL_strdup("/");
+}
+
+char *SDL_SYS_GetCurrentDirectory(void)
+{
+    return SDL_strdup("/");
+}
+
+/* --- enumeration -------------------------------------------------------- */
+
+/* Trim trailing spaces from a FAT 8.3 name into a NUL-terminated buffer. */
+static void LUMINA_TrimName(const char name[12], char out[13])
+{
+    int len = 12;
+    int i;
+    while (len > 0 && name[len - 1] == ' ') {
+        --len;
+    }
+    for (i = 0; i < len; ++i) {
+        out[i] = name[i];
+    }
+    out[len] = '\0';
+}
+
+bool SDL_SYS_EnumerateDirectory(const char *path, SDL_EnumerateDirectoryCallback cb, void *userdata)
+{
+    lumina_dir_entry_t entries[LUMINA_FS_MAX_ENTRIES];
+    int count, i;
+
+    (void)path; /* kernel lists the root directory regardless of path */
+
+    count = lumina_file_list(entries, (int)sizeof(entries));
+    if (count < 0) {
+        return SDL_SetError("LUMINA FILE_LIST failed");
+    }
+
+    for (i = 0; i < count; ++i) {
+        char fname[13];
+        SDL_EnumerationResult result;
+
+        LUMINA_TrimName(entries[i].name, fname);
+        if (fname[0] == '\0') {
+            continue;
+        }
+        result = cb(userdata, path, fname);
+        if (result == SDL_ENUM_SUCCESS) {
+            break;
+        } else if (result == SDL_ENUM_FAILURE) {
+            return SDL_SetError("Directory enumeration callback failed");
+        }
+    }
+    return true;
+}
+
+/* --- path info ---------------------------------------------------------- */
+
+bool SDL_SYS_GetPathInfo(const char *path, SDL_PathInfo *info)
+{
+    lumina_dir_entry_t entries[LUMINA_FS_MAX_ENTRIES];
+    int count, i;
+    const char *name = path;
+
+    if (!info) {
+        return SDL_SetError("Invalid SDL_PathInfo pointer");
+    }
+    SDL_zerop(info);
+
+    /* Skip a leading '/' so "/FOO.TXT" matches the flat root entry. */
+    while (*name == '/') {
+        ++name;
+    }
+
+    count = lumina_file_list(entries, (int)sizeof(entries));
+    if (count < 0) {
+        return SDL_SetError("LUMINA FILE_LIST failed");
+    }
+
+    for (i = 0; i < count; ++i) {
+        char fname[13];
+        LUMINA_TrimName(entries[i].name, fname);
+        if (fname[0] == '\0') {
+            continue;
+        }
+        if (SDL_strcasecmp(fname, name) == 0) {
+            info->type = (entries[i].attr & LUMINA_FS_ATTR_DIRECTORY)
+                             ? SDL_PATHTYPE_DIRECTORY
+                             : SDL_PATHTYPE_FILE;
+            info->size = (Uint64)entries[i].size;
+            /* FAT16 timestamps are not exposed by the syscall; leave 0. */
+            return true;
+        }
+    }
+
+    info->type = SDL_PATHTYPE_NONE;
+    return SDL_SetError("Path does not exist: %s", path);
+}
+
+/* --- mutating operations: no kernel API --------------------------------- */
+
+bool SDL_SYS_RemovePath(const char *path)
+{
+    (void)path;
+    return SDL_Unsupported();
+}
+
+bool SDL_SYS_RenamePath(const char *oldpath, const char *newpath)
+{
+    (void)oldpath; (void)newpath;
+    return SDL_Unsupported();
+}
+
+bool SDL_SYS_CopyFile(const char *oldpath, const char *newpath)
+{
+    (void)oldpath; (void)newpath;
+    return SDL_Unsupported();
+}
+
+bool SDL_SYS_CreateDirectory(const char *path)
+{
+    (void)path;
+    return SDL_Unsupported();
+}
+
+/* --- SDL_IOFromFile backend ---------------------------------------------
+   The kernel's FILE_READ/FILE_WRITE are whole-file, path-based calls with a
+   4096-byte maximum. We therefore read the entire file into memory at open
+   time and serve a normal SDL_IOStream over that buffer; writes are buffered
+   and flushed back to FILE_WRITE on close. This keeps SDL_LoadFile / BMP /
+   WAV loading working for files up to the kernel's buffer limit.
+*/
+typedef struct LUMINA_IOData
+{
+    char *buf;        /* in-memory file contents */
+    size_t size;      /* valid bytes */
+    size_t cap;       /* allocated bytes */
+    size_t pos;       /* current stream position */
+    bool writable;
+    bool dirty;
+    char path[64];    /* FAT 8.3 name */
+} LUMINA_IOData;
+
+static Sint64 SDLCALL LUMINA_IO_size(void *userdata)
+{
+    LUMINA_IOData *io = (LUMINA_IOData *)userdata;
+    return (Sint64)io->size;
+}
+
+static Sint64 SDLCALL LUMINA_IO_seek(void *userdata, Sint64 offset, SDL_IOWhence whence)
+{
+    LUMINA_IOData *io = (LUMINA_IOData *)userdata;
+    Sint64 base;
+
+    switch (whence) {
+    case SDL_IO_SEEK_SET: base = 0; break;
+    case SDL_IO_SEEK_CUR: base = (Sint64)io->pos; break;
+    case SDL_IO_SEEK_END: base = (Sint64)io->size; break;
+    default: return -1;
+    }
+    {
+        Sint64 newpos = base + offset;
+        if (newpos < 0) {
+            return -1;
+        }
+        io->pos = (size_t)newpos;
+        return newpos;
+    }
+}
+
+static size_t SDLCALL LUMINA_IO_read(void *userdata, void *ptr, size_t size, SDL_IOStatus *status)
+{
+    LUMINA_IOData *io = (LUMINA_IOData *)userdata;
+    size_t avail;
+
+    if (io->pos >= io->size) {
+        *status = SDL_IO_STATUS_EOF;
+        return 0;
+    }
+    avail = io->size - io->pos;
+    if (size > avail) {
+        size = avail;
+    }
+    SDL_memcpy(ptr, io->buf + io->pos, size);
+    io->pos += size;
+    return size;
+}
+
+static size_t SDLCALL LUMINA_IO_write(void *userdata, const void *ptr, size_t size, SDL_IOStatus *status)
+{
+    LUMINA_IOData *io = (LUMINA_IOData *)userdata;
+
+    if (!io->writable) {
+        *status = SDL_IO_STATUS_READONLY;
+        return 0;
+    }
+    if (io->pos + size > io->cap) {
+        size_t newcap = (io->pos + size + 4095) & ~(size_t)4095;
+        char *nb = (char *)SDL_realloc(io->buf, newcap);
+        if (!nb) {
+            *status = SDL_IO_STATUS_ERROR;
+            return 0;
+        }
+        io->buf = nb;
+        io->cap = newcap;
+    }
+    SDL_memcpy(io->buf + io->pos, ptr, size);
+    io->pos += size;
+    if (io->pos > io->size) {
+        io->size = io->pos;
+    }
+    io->dirty = true;
+    return size;
+}
+
+static bool SDLCALL LUMINA_IO_flush(void *userdata, SDL_IOStatus *status)
+{
+    LUMINA_IOData *io = (LUMINA_IOData *)userdata;
+    (void)status;
+    if (io->dirty && io->writable) {
+        if (lumina_file_write(io->path, io->buf, (int)io->size) < 0) {
+            return false;
+        }
+        io->dirty = false;
+    }
+    return true;
+}
+
+static bool SDLCALL LUMINA_IO_close(void *userdata)
+{
+    LUMINA_IOData *io = (LUMINA_IOData *)userdata;
+    bool ok = true;
+    if (io->dirty && io->writable) {
+        if (lumina_file_write(io->path, io->buf, (int)io->size) < 0) {
+            ok = false;
+        }
+    }
+    SDL_free(io->buf);
+    SDL_free(io);
+    return ok;
+}
+
+SDL_IOStream *SDL_LUMINA_IOFromFile(const char *file, const char *mode)
+{
+    LUMINA_IOData *io;
+    SDL_IOStreamInterface iface;
+    SDL_IOStream *iostr;
+    const char *name = file;
+    bool writable = (SDL_strchr(mode, 'w') != NULL) ||
+                    (SDL_strchr(mode, 'a') != NULL) ||
+                    (SDL_strchr(mode, '+') != NULL);
+    bool truncate = SDL_strchr(mode, 'w') != NULL;
+
+    while (*name == '/') {
+        ++name;
+    }
+
+    io = (LUMINA_IOData *)SDL_calloc(1, sizeof(*io));
+    if (!io) {
+        return NULL;
+    }
+    SDL_strlcpy(io->path, name, sizeof(io->path));
+    io->writable = writable;
+
+    io->cap = 4096;
+    io->buf = (char *)SDL_malloc(io->cap);
+    if (!io->buf) {
+        SDL_free(io);
+        return NULL;
+    }
+
+    if (!truncate) {
+        int n = lumina_file_read(name, io->buf, (int)io->cap);
+        io->size = (n > 0) ? (size_t)n : 0;
+    }
+    io->pos = (SDL_strchr(mode, 'a') != NULL) ? io->size : 0;
+
+    SDL_INIT_INTERFACE(&iface);
+    iface.size = LUMINA_IO_size;
+    iface.seek = LUMINA_IO_seek;
+    iface.read = LUMINA_IO_read;
+    iface.write = LUMINA_IO_write;
+    iface.flush = LUMINA_IO_flush;
+    iface.close = LUMINA_IO_close;
+
+    iostr = SDL_OpenIO(&iface, io);
+    if (!iostr) {
+        LUMINA_IO_close(io);
+    }
+    return iostr;
+}
+
+#endif /* SDL_FILESYSTEM_LUMINA || SDL_FSOPS_LUMINA */
