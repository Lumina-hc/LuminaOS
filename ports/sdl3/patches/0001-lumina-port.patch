diff --git a/src/video/lumina/SDL_luminaevents.c b/src/video/lumina/SDL_luminaevents.c
new file mode 100644
index 0000000..6f95287
--- /dev/null
+++ b/src/video/lumina/SDL_luminaevents.c
@@ -0,0 +1,93 @@
+/*
+  LuminaOS SDL3 video driver - event pump.
+
+  Polls the LuminaOS kernel's non-blocking keyboard/mouse syscalls once per
+  SDL_PumpEvents() and injects the results through SDL's event layer.
+*/
+#include "SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_LUMINA
+
+#include "../SDL_sysvideo.h"
+#include "../../events/SDL_events_c.h"
+#include "../../events/SDL_keyboard_c.h"
+#include "../../events/SDL_mouse_c.h"
+#include "SDL_luminavideo.h"
+#include "lumina_syscall.h"
+
+/* LuminaOS getchar_nb() yields ASCII/control codes. Map the common ones to
+   SDL scancodes; everything else falls back to SDL_SCANCODE_UNKNOWN. */
+static SDL_Scancode LUMINA_ScancodeFromAscii(int ch)
+{
+    if (ch >= 'a' && ch <= 'z') {
+        return (SDL_Scancode)(SDL_SCANCODE_A + (ch - 'a'));
+    }
+    if (ch >= 'A' && ch <= 'Z') {
+        return (SDL_Scancode)(SDL_SCANCODE_A + (ch - 'A'));
+    }
+    if (ch >= '0' && ch <= '9') {
+        return (SDL_Scancode)(SDL_SCANCODE_0 + (ch - '0'));
+    }
+    switch (ch) {
+    case ' ':        return SDL_SCANCODE_SPACE;
+    case '\n':
+    case '\r':       return SDL_SCANCODE_RETURN;
+    case '\t':       return SDL_SCANCODE_TAB;
+    case 8:
+    case 127:        return SDL_SCANCODE_BACKSPACE;
+    case 27:         return SDL_SCANCODE_ESCAPE;
+    default:         return SDL_SCANCODE_UNKNOWN;
+    }
+}
+
+void LUMINA_PumpEvents(SDL_VideoDevice *_this)
+{
+    SDL_Window *window;
+    static bool prev_left, prev_right;
+    int x, y;
+    Uint64 now;
+
+    (void)_this;
+    now = SDL_GetTicksNS();
+
+    /* Close request from the window manager / OS. */
+    if (lumina_sys_win_should_close()) {
+        SDL_SendQuit();
+    }
+
+    /* Mouse motion (absolute coordinates relative to the active window). */
+    window = SDL_GetMouseFocus();
+    x = lumina_mouse_x();
+    y = lumina_mouse_y();
+    if (window) {
+        SDL_SendMouseMotion(now, window, 0, false, (float)x, (float)y);
+    }
+
+    /* Mouse buttons: compare against the previous poll to generate events. */
+    {
+        bool left = lumina_mouse_left() ? true : false;
+        bool right = lumina_mouse_right() ? true : false;
+        if (window) {
+            if (left != prev_left) {
+                SDL_SendMouseButton(now, window, 0, SDL_BUTTON_LEFT, left);
+            }
+            if (right != prev_right) {
+                SDL_SendMouseButton(now, window, 0, SDL_BUTTON_RIGHT, right);
+            }
+        }
+        prev_left = left;
+        prev_right = right;
+    }
+
+    /* Keyboard: non-blocking read, one key per pump. */
+    {
+        int ch = lumina_getchar_nb();
+        if (ch >= 0 && ch != 0) {
+            SDL_Scancode scancode = LUMINA_ScancodeFromAscii(ch);
+            SDL_SendKeyboardKey(now, 0, ch, scancode, true);
+            SDL_SendKeyboardKey(now, 0, ch, scancode, false);
+        }
+    }
+}
+
+#endif /* SDL_VIDEO_DRIVER_LUMINA */
diff --git a/src/video/lumina/SDL_luminaframebuffer.c b/src/video/lumina/SDL_luminaframebuffer.c
new file mode 100644
index 0000000..1e33d93
--- /dev/null
+++ b/src/video/lumina/SDL_luminaframebuffer.c
@@ -0,0 +1,120 @@
+/*
+  LuminaOS SDL3 video driver - software framebuffer.
+
+  Mirrors src/video/dummy/SDL_nullframebuffer.c, but UpdateWindowFramebuffer
+  pushes the SDL surface to the screen through the LuminaOS gfx syscalls.
+
+  LuminaOS exposes no bulk framebuffer-blit syscall, so we blit with one
+  FILL_RECT per horizontal run of identical pixels. This is slow at high
+  resolutions but keeps the kernel ABI unchanged for this first port.
+*/
+#include "SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_LUMINA
+
+#include "../SDL_sysvideo.h"
+#include "../SDL_pixels_c.h"
+#include "../../SDL_properties_c.h"
+#include "SDL_luminavideo.h"
+#include "lumina_syscall.h"
+
+bool SDL_LUMINA_CreateWindowFramebuffer(SDL_VideoDevice *_this, SDL_Window *window,
+                                       SDL_PixelFormat *format, void **pixels, int *pitch)
+{
+    SDL_Surface *surface;
+    const SDL_PixelFormat surface_format = SDL_PIXELFORMAT_XRGB8888;
+    int w, h;
+
+    (void)_this;
+
+    SDL_GetWindowSizeInPixels(window, &w, &h);
+    surface = SDL_CreateSurfaceZeroed(w, h, surface_format);
+    if (!surface) {
+        return false;
+    }
+
+    SDL_SetSurfaceProperty(SDL_GetWindowProperties(window), LUMINA_SURFACE, surface);
+    *format = surface_format;
+    *pixels = surface->pixels;
+    *pitch = surface->pitch;
+    return true;
+}
+
+void SDL_LUMINA_DestroyWindowFramebuffer(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    (void)_this;
+    SDL_ClearProperty(SDL_GetWindowProperties(window), LUMINA_SURFACE);
+}
+
+/* Blit a rectangle of XRGB8888 pixels using horizontal runs. */
+static void LUMINA_BlitSurface(SDL_Surface *surface, const SDL_Rect *dirty)
+{
+    const Uint32 *row;
+    int y, x;
+
+    if (SDL_LockSurface(surface) < 0) {
+        return;
+    }
+
+    for (y = dirty->y; y < dirty->y + dirty->h; ++y) {
+        if (y < 0 || y >= surface->h) {
+            continue;
+        }
+        row = (const Uint32 *)((const Uint8 *)surface->pixels + (size_t)y * surface->pitch);
+        x = dirty->x;
+        while (x < dirty->x + dirty->w) {
+            Uint32 color;
+            int run;
+
+            if (x < 0 || x >= surface->w) {
+                ++x;
+                continue;
+            }
+            color = row[x];
+            run = 1;
+            while (x + run < dirty->x + dirty->w &&
+                   x + run < surface->w &&
+                   row[x + run] == color) {
+                ++run;
+            }
+            /* gfx_fill_rect packs w | (h << 16); keep w within 16 bits. */
+            if (run > 0xffff) {
+                run = 0xffff;
+            }
+            lumina_gfx_fill_rect(x, y, run, 1, color);
+            x += run;
+        }
+    }
+
+    SDL_UnlockSurface(surface);
+}
+
+bool SDL_LUMINA_UpdateWindowFramebuffer(SDL_VideoDevice *_this, SDL_Window *window,
+                                       const SDL_Rect *rects, int numrects)
+{
+    SDL_Surface *surface;
+    int i;
+
+    (void)_this;
+
+    surface = (SDL_Surface *)SDL_GetPointerProperty(SDL_GetWindowProperties(window),
+                                                    LUMINA_SURFACE, NULL);
+    if (!surface) {
+        return SDL_SetError("Couldn't find LUMINA surface for window");
+    }
+
+    if (numrects == 0) {
+        SDL_Rect full = { 0, 0, surface->w, surface->h };
+        LUMINA_BlitSurface(surface, &full);
+    } else {
+        for (i = 0; i < numrects; ++i) {
+            LUMINA_BlitSurface(surface, &rects[i]);
+        }
+    }
+
+    /* Blit the window surface to the framebuffer. */
+    lumina_gfx_flush();
+    return true;
+}
+
+#endif /* SDL_VIDEO_DRIVER_LUMINA */
diff --git a/src/video/lumina/SDL_luminavideo.c b/src/video/lumina/SDL_luminavideo.c
new file mode 100644
index 0000000..a0168de
--- /dev/null
+++ b/src/video/lumina/SDL_luminavideo.c
@@ -0,0 +1,92 @@
+/*
+  LuminaOS SDL3 video driver - bootstrap and device setup.
+
+  LuminaOS user apps are freestanding ELF64 processes. When a window is
+  foreground, gfx_* syscalls draw into a window-local surface which the
+  kernel blits to the back buffer on gfx_flush(). We expose that as a single
+  software-framebuffer display whose size comes from gfx_w()/gfx_h().
+*/
+#include "SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_LUMINA
+
+#include "../SDL_sysvideo.h"
+#include "../SDL_pixels_c.h"
+#include "../../events/SDL_events_c.h"
+
+#include "SDL_luminavideo.h"
+#include "lumina_syscall.h"
+
+#define LUMINAVID_DRIVER_NAME "lumina"
+
+/* Forward declarations (defined below). */
+static bool LUMINA_SetRelativeMouseMode(bool enabled);
+bool LUMINA_VideoInit(SDL_VideoDevice *_this);
+void LUMINA_VideoQuit(SDL_VideoDevice *_this);
+
+/* ---- device lifecycle -------------------------------------------------- */
+static void LUMINA_DeleteDevice(SDL_VideoDevice *device)
+{
+    SDL_free(device);
+}
+
+static SDL_VideoDevice *LUMINA_CreateDevice(void)
+{
+    SDL_VideoDevice *device = (SDL_VideoDevice *)SDL_calloc(1, sizeof(SDL_VideoDevice));
+    if (!device) {
+        return NULL;
+    }
+
+    device->VideoInit = LUMINA_VideoInit;
+    device->VideoQuit = LUMINA_VideoQuit;
+    device->PumpEvents = LUMINA_PumpEvents;
+    device->CreateWindowFramebuffer = SDL_LUMINA_CreateWindowFramebuffer;
+    device->UpdateWindowFramebuffer = SDL_LUMINA_UpdateWindowFramebuffer;
+    device->DestroyWindowFramebuffer = SDL_LUMINA_DestroyWindowFramebuffer;
+    device->free = LUMINA_DeleteDevice;
+
+    return device;
+}
+
+VideoBootStrap LUMINA_bootstrap = {
+    LUMINAVID_DRIVER_NAME, "SDL LuminaOS framebuffer driver",
+    LUMINA_CreateDevice,
+    NULL,  /* no ShowMessageBox */
+    true   /* preferred on LuminaOS */
+};
+
+/* ---- init / quit ------------------------------------------------------- */
+static bool LUMINA_SetRelativeMouseMode(bool enabled)
+{
+    (void)enabled;
+    return true; /* relative mode unsupported; absolute mouse only */
+}
+
+bool LUMINA_VideoInit(SDL_VideoDevice *_this)
+{
+    SDL_DisplayMode mode;
+
+    (void)_this;
+
+    SDL_zero(mode);
+    mode.format = SDL_PIXELFORMAT_XRGB8888;
+    mode.w = lumina_gfx_w();
+    mode.h = lumina_gfx_h();
+    if (mode.w <= 0 || mode.h <= 0) {
+        mode.w = 1024;
+        mode.h = 768;
+    }
+    if (SDL_AddBasicVideoDisplay(&mode) == 0) {
+        return false;
+    }
+
+    SDL_GetMouse()->SetRelativeMouseMode = LUMINA_SetRelativeMouseMode;
+    return true;
+}
+
+void LUMINA_VideoQuit(SDL_VideoDevice *_this)
+{
+    (void)_this;
+}
+
+#endif /* SDL_VIDEO_DRIVER_LUMINA */
