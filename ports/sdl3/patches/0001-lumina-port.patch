diff --git a/src/video/lumina/lumina_syscall.h b/src/video/lumina/lumina_syscall.h
new file mode 100644
index 0000000..fad2d59
--- /dev/null
+++ b/src/video/lumina/lumina_syscall.h
@@ -0,0 +1,111 @@
+/*
+  LuminaOS syscall wrappers for the SDL3 port.
+
+  LuminaOS user applications talk to the kernel through the int 0x80 ABI:
+    rax = syscall number, rdi/rsi/rdx/rcx = arguments, rax = return value.
+
+  The SDK (LuminaOS-SDK/include/app_libc.h) already documents these; this
+  header re-exposes them with a lumina_ prefix so they do not collide with
+  SDL's own namespace, and adds the few extra calls the port needs.
+*/
+#ifndef LUMINA_SYSCALL_H
+#define LUMINA_SYSCALL_H
+
+#include <stdint.h>
+
+#define LUMINA_SYSCALL_EXIT            0
+#define LUMINA_SYSCALL_PUTPIXEL        1
+#define LUMINA_SYSCALL_FILL_RECT       2
+#define LUMINA_SYSCALL_DRAW_RECT       3
+#define LUMINA_SYSCALL_DRAW_CHAR       4
+#define LUMINA_SYSCALL_DRAW_TEXT       5
+#define LUMINA_SYSCALL_GFX_CLEAR       6
+#define LUMINA_SYSCALL_GFX_FLUSH       7
+#define LUMINA_SYSCALL_GFX_W           8
+#define LUMINA_SYSCALL_GFX_H           9
+#define LUMINA_SYSCALL_GETCHAR         10
+#define LUMINA_SYSCALL_GETCHAR_NB      11
+#define LUMINA_SYSCALL_MOUSE_X         12
+#define LUMINA_SYSCALL_MOUSE_Y         13
+#define LUMINA_SYSCALL_MOUSE_L         14
+#define LUMINA_SYSCALL_MOUSE_R         15
+#define LUMINA_SYSCALL_MOUSE_CLICK     16
+#define LUMINA_SYSCALL_FILE_READ       17
+#define LUMINA_SYSCALL_FILE_WRITE      18
+#define LUMINA_SYSCALL_FILE_LIST       19
+#define LUMINA_SYSCALL_SLEEP           20
+#define LUMINA_SYSCALL_CURSOR          21
+#define LUMINA_SYSCALL_WIN_INFO        22
+#define LUMINA_SYSCALL_SYSINFO         23
+#define LUMINA_SYSCALL_WIN_SHOULD_CLOSE 24
+#define LUMINA_SYSCALL_OPEN_FILE       25
+#define LUMINA_SYSCALL_GET_OPEN_FILE   26
+#define LUMINA_SYSCALL_WIN_MINIMIZED   27
+#define LUMINA_SYSCALL_MINIMIZE        28
+#define LUMINA_SYSCALL_GET_TICKS       29
+#define LUMINA_SYSCALL_PIPE            30
+#define LUMINA_SYSCALL_PIPE_READ       31
+#define LUMINA_SYSCALL_PIPE_WRITE      32
+#define LUMINA_SYSCALL_CLOSE           33
+#define LUMINA_SYSCALL_SPAWN           34
+#define LUMINA_SYSCALL_GETARG          35
+#define LUMINA_SYSCALL_GETPID          36
+#define LUMINA_SYSCALL_WAIT            37
+#define LUMINA_SYSCALL_LIST_PROCS      38
+#define LUMINA_SYSCALL_YIELD           39
+
+typedef struct {
+    int win_x, win_y, win_w, win_h;
+    int client_x, client_y, client_w, client_h;
+    int close_x, close_y, close_w, close_h;
+} lumina_win_info_t;
+
+typedef struct {
+    uint32_t mem_total_kb;
+    uint32_t mem_free_kb;
+    uint32_t mem_used_kb;
+    uint32_t heap_free_kb;
+    uint32_t heap_used_kb;
+} lumina_sysinfo_t;
+
+typedef struct {
+    char name[12];
+    uint8_t attr;
+    uint8_t pad;
+    uint32_t size;
+} __attribute__((packed)) lumina_dir_entry_t;
+
+static inline long lumina_syscall5(long n, long a1, long a2, long a3, long a4)
+{
+    long r;
+    __asm__ volatile (
+        "int $0x80"
+        : "=a"(r)
+        : "a"(n), "D"(a1), "S"(a2), "d"(a3), "c"(a4)
+        : "memory");
+    return r;
+}
+
+static inline void  lumina_sys_exit(void)                        { lumina_syscall5(LUMINA_SYSCALL_EXIT, 0, 0, 0, 0); }
+static inline void  lumina_gfx_putpixel(int x, int y, uint32_t c){ lumina_syscall5(LUMINA_SYSCALL_PUTPIXEL, x, y, (long)c, 0); }
+static inline void  lumina_gfx_fill_rect(int x, int y, int w, int h, uint32_t c) { lumina_syscall5(LUMINA_SYSCALL_FILL_RECT, x, y, w | ((long)h << 16), (long)c); }
+static inline void  lumina_gfx_draw_text(int x, int y, const char *s, uint32_t c) { lumina_syscall5(LUMINA_SYSCALL_DRAW_TEXT, x, y, (long)s, (long)c); }
+static inline void  lumina_gfx_clear(uint32_t c)                 { lumina_syscall5(LUMINA_SYSCALL_GFX_CLEAR, (long)c, 0, 0, 0); }
+static inline void  lumina_gfx_flush(void)                       { lumina_syscall5(LUMINA_SYSCALL_GFX_FLUSH, 0, 0, 0, 0); }
+static inline int   lumina_gfx_w(void)                           { return (int)lumina_syscall5(LUMINA_SYSCALL_GFX_W, 0, 0, 0,0); }
+static inline int   lumina_gfx_h(void)                           { return (int)lumina_syscall5(LUMINA_SYSCALL_GFX_H, 0, 0, 0,0); }
+static inline int   lumina_getchar_nb(void)                      { return (int)lumina_syscall5(LUMINA_SYSCALL_GETCHAR_NB, 0, 0, 0,0); }
+static inline int   lumina_mouse_x(void)                         { return (int)lumina_syscall5(LUMINA_SYSCALL_MOUSE_X, 0, 0, 0,0); }
+static inline int   lumina_mouse_y(void)                         { return (int)lumina_syscall5(LUMINA_SYSCALL_MOUSE_Y, 0, 0, 0,0); }
+static inline int   lumina_mouse_left(void)                      { return (int)lumina_syscall5(LUMINA_SYSCALL_MOUSE_L, 0, 0, 0,0); }
+static inline int   lumina_mouse_right(void)                     { return (int)lumina_syscall5(LUMINA_SYSCALL_MOUSE_R, 0, 0, 0,0); }
+static inline int   lumina_mouse_click(void)                     { return (int)lumina_syscall5(LUMINA_SYSCALL_MOUSE_CLICK, 0, 0, 0,0); }
+static inline int   lumina_file_read(const char *p, void *b, int n)  { return (int)lumina_syscall5(LUMINA_SYSCALL_FILE_READ, (long)p, (long)b, n, 0); }
+static inline int   lumina_file_write(const char *p, const void *b, int n) { return (int)lumina_syscall5(LUMINA_SYSCALL_FILE_WRITE, (long)p, (long)b, n, 0); }
+static inline int   lumina_file_list(void *buf, int n)           { return (int)lumina_syscall5(LUMINA_SYSCALL_FILE_LIST, (long)buf, 0, n, 0); }
+static inline void  lumina_sys_sleep(int ms)                     { lumina_syscall5(LUMINA_SYSCALL_SLEEP, ms, 0, 0, 0); }
+static inline uint32_t lumina_get_ticks(void)                    { return (uint32_t)lumina_syscall5(LUMINA_SYSCALL_GET_TICKS, 0, 0, 0, 0); }
+static inline void  lumina_sys_win_info(lumina_win_info_t *info)  { lumina_syscall5(LUMINA_SYSCALL_WIN_INFO, (long)info, 0, 0, 0); }
+static inline int   lumina_sys_win_should_close(void)            { return (int)lumina_syscall5(LUMINA_SYSCALL_WIN_SHOULD_CLOSE, 0, 0, 0,0); }
+
+#endif /* LUMINA_SYSCALL_H */
